{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "NodeNext",
                            "moduleResolution":  "NodeNext",
                            "lib":  [
                                        "ES2022"
                                    ],
                            "types":  [
                                          "node"
                                      ],
                            "outDir":  "dist-server",
                            "rootDir":  ".",
                            "declaration":  false,
                            "sourceMap":  false,
                            "strict":  true,
                            "skipLibCheck":  true,
                            "esModuleInterop":  true,
                            "isolatedModules":  true,
                            "noEmit":  false
                        },
    "include":  [
                    "server.ts",
                    "server/**/*.ts",
                    "!server/**/*.test.ts"
                ]
}
