{
  "name": "nextq",
  "private": true,
  "version": "1.0.0",
  "description": "Premium clinic queue and token management platform",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "dev:server": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build:frontend": "node ./node_modules/vite/bin/vite.js build",
    "build:server": "node ./node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "build": "npm run lint && npm run build:frontend && npm run build:server",
    "test": "node scripts/run-tests.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "start": "node dist-server/server.js",
    "clean": "node -e \"const fs=require('fs');['dist','dist-server','server.js'].forEach((p)=>fs.existsSync(p)&&fs.rmSync(p,{recursive:true,force:true}))\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "db:migrate": "node ./node_modules/tsx/dist/cli.mjs server/db/migrations.ts migrate",
    "db:reset": "node ./node_modules/tsx/dist/cli.mjs server/db/migrations.ts reset"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.11.0",
    "qrcode": "^1.5.4",
    "qs": "6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
